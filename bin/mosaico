#!/usr/bin/env python3
"""mosaico — launcher de apps em grade (estilo iPad) para toque e controle.

Tela cheia, ícones grandes, sem depender de teclado físico. Os apps vêm de
duas fontes: o catálogo do `iniciar` (~/.config/iniciar/apps.conf) e os
arquivos .desktop de /usr/share/applications e ~/.local/share/applications.
A grade (ordem + itens) persiste em ~/.config/mosaico/apps.json; na primeira
execução ela é semeada com os favoritos (favorito=1) do apps.conf.

Uso: mosaico [--dump]      (MOSAICO_START=edit|add abre já no modo edição / na lista)

  toque / Enter (A)      abre o app e fecha o Mosaico
  toque longo / Editar   modo edição: × remove; tocar um ícone o "pega",
                         tocar outro lugar o solta ali; Backspace remove
  Esc (B)                fecha (ou sai do modo edição / da lista de adicionar)
  chamada repetida       fecha a instância aberta (toggle)
"""

import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gdk", "4.0")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

try:  # GLib ≥ 2.80 moveu DesktopAppInfo para GioUnix
    gi.require_version("GioUnix", "2.0")
    from gi.repository import GioUnix  # noqa: E402
    DesktopAppInfo = GioUnix.DesktopAppInfo
except (ValueError, ImportError, AttributeError):
    DesktopAppInfo = Gio.DesktopAppInfo

APP_ID = "org.omarchy.mosaico"
HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config"))
CFG_DIR = XDG_CONFIG / "mosaico"
APPS_JSON = CFG_DIR / "apps.json"
INICIAR_CONF = Path(os.environ.get("INICIAR_CONFIG_DIR", XDG_CONFIG / "iniciar")) / "apps.conf"
WORK_DIR = Path(os.environ.get("INICIAR_WORK_DIR", HOME / "Work"))
DESKTOP_DIRS = [
    Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share")) / "applications",
    Path("/usr/local/share/applications"),
    Path("/usr/share/applications"),
]

