#!/usr/bin/env bash
# Virtual on-screen keyboard for GPD Pocket 4 (port do steamdeck-osk, configuração original) / Omarchy (wvkbd-deck).
# Compact height so the password / focused field stays visible above it.
set -euo pipefail

BIN="${STEAMDECK_OSK_BIN:-$HOME/.local/bin/wvkbd-deck-ux}"
[[ -x "$BIN" ]] || BIN=/usr/local/bin/wvkbd-deck
[[ -x "$BIN" ]] || BIN=/usr/local/bin/wvkbd-deskintl
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/gpd-osk.pid"

# Portrait / landscape heights in compositor pixels (~1/3–40% of 800x500 logical).
HEIGHT_P="${GPD_OSK_HEIGHT:-400}"
HEIGHT_L="${GPD_OSK_LANDSCAPE_HEIGHT:-400}"
FONT="${STEAMDECK_OSK_FONT:-Sans Bold 13}"
RADIUS="${STEAMDECK_OSK_RADIUS:-8}"

# Dark palette (tema ativo do Omarchy).
BG="${STEAMDECK_OSK_BG:-070B12}"
FG="${STEAMDECK_OSK_FG:-203447}"
FG_SP="${STEAMDECK_OSK_FG_SP:-30475B}"
PRESS="${STEAMDECK_OSK_PRESS:-00FFE7}"
TEXT="${STEAMDECK_OSK_TEXT:-E8F4FF}"

usage() {
  cat <<'EOF'
Usage: steamdeck-osk <command>

  start           Start hidden (session default)
  start-visible   Start shown (login / lock)
  stop            Stop the keyboard process
  show            Show keyboard
  hide            Hide keyboard
  toggle          Toggle visibility (starts if needed)
  status          Print running state
EOF
}

running_pid() {
  if [[ -f "$PIDFILE" ]]; then
    local pid
    pid="$(cat "$PIDFILE" 2>/dev/null || true)"
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi
  # Match whichever binary is actually running.
  pgrep -n -f "(^|/)(wvkbd-deck-ux|wvkbd-deck|wvkbd-deskintl)( |$)" 2>/dev/null || true
}

start_kbd() {
  local mode="${1:-hidden}" # hidden | visible
  local pid
  pid="$(running_pid)"
  if [[ -n "$pid" ]]; then
    echo "$pid" >"$PIDFILE"
    if [[ "$mode" == "visible" ]]; then
      kill -USR2 "$pid" 2>/dev/null || true
    fi
    return 0
  fi

  if [[ ! -x "$BIN" ]]; then
    echo "steamdeck-osk: keyboard binary not found at $BIN" >&2
    return 1
  fi

  # wvkbd-deck (custom build) does not support --auto / --text-press.
  local layers="full,special"  # GPD: o fonte no GitHub não tem a camada deck
  local landscape_layers="landscape,landscapespecial"
  if [[ "$(basename "$BIN")" == "wvkbd-deck-ux" ]]; then
    layers="thumb,splitthumb,digits,digitssplit,deck,special"
    landscape_layers="splitthumb,thumb,digitssplit,digits,deck,special"
  fi
  if [[ "$(basename "$BIN")" == "wvkbd-deskintl" ]]; then
    layers="full,special"
    landscape_layers="$layers"
  fi

  local -a args=(
    -H "$HEIGHT_P"
    -L "$HEIGHT_L"
    -R "$RADIUS"
    --fn "$FONT"
    -l "$layers"
    --landscape-layers "$landscape_layers"
    --bg "$BG"
    --fg "$FG"
    --fg-sp "$FG_SP"
    --press "$PRESS"
    --press-sp "$PRESS"
    --text "$TEXT"
    --text-sp "$TEXT"
  )
  [[ "$mode" == "hidden" ]] && args+=(--hidden)

  "$BIN" "${args[@]}" >/dev/null 2>&1 &
  echo $! >"$PIDFILE"
  disown $! 2>/dev/null || true

  # Confirm the process actually stayed up (bad flags used to exit immediately).
  sleep 0.15
  if ! kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    rm -f "$PIDFILE"
    echo "steamdeck-osk: keyboard failed to start" >&2
    return 1
  fi
}

send_signal() {
  local sig="$1"
  local pid
  pid="$(running_pid)"
  if [[ -z "$pid" ]]; then
    return 1
  fi
  kill "-$sig" "$pid" 2>/dev/null
}

cmd="${1:-}"
case "$cmd" in
  start)
    start_kbd hidden
    ;;
  start-visible)
    start_kbd visible
    ;;
  stop)
    pid="$(running_pid || true)"
    if [[ -n "${pid:-}" ]]; then
      kill "$pid" 2>/dev/null || true
      rm -f "$PIDFILE"
    fi
    ;;
  show)
    if ! send_signal USR2; then
      start_kbd visible
    fi
    ;;
  hide)
    send_signal USR1 || true
    ;;
  toggle)
    if ! send_signal RTMIN; then
      start_kbd visible
    fi
    ;;
  status)
    pid="$(running_pid || true)"
    if [[ -n "${pid:-}" ]]; then
      echo "running pid=$pid"
    else
      echo "stopped"
      exit 1
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  "")
    usage
    exit 1
    ;;
  *)
    echo "steamdeck-osk: unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
